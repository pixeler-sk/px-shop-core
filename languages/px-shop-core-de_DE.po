#: includes/class-px-catalog.php:39 includes/class-px-catalog.php:45
#: includes/modules.php:282
msgid "Catalog mode"
msgstr "Katalogmodus"

#: includes/class-px-catalog.php:41
msgid ""
"Turn the shop into a browse-only catalog: add-to-cart buttons and the cart "
"are hidden. Useful for showrooms or price-on-request shops."
msgstr ""
"Macht den Shop zu einem reinen Ansichtskatalog: „In den Warenkorb“-Buttons "
"und der Warenkorb werden ausgeblendet. Nützlich für Showrooms oder Shops mit"
" Preisen auf Anfrage."

#: includes/class-px-catalog.php:46
msgid "Enable catalog mode"
msgstr "Katalogmodus aktivieren"

#: includes/class-px-catalog.php:52
msgid "Prices"
msgstr "Preise"

#: includes/class-px-catalog.php:53
msgid "Also hide prices"
msgstr "Auch Preise ausblenden"

#: includes/class-px-catalog.php:59
msgid "Replacement button text"
msgstr "Text des Ersatz-Buttons"

#: includes/class-px-catalog.php:60
msgid "Shown instead of \"Add to cart\". Empty falls back to \"View product\"."
msgstr ""
"Wird statt „In den Warenkorb“ angezeigt. Leer bedeutet „Produkt ansehen“."

#: includes/class-px-catalog.php:66
msgid "Replacement button link"
msgstr "Link des Ersatz-Buttons"

#: includes/class-px-catalog.php:67
msgid "Where the button points. Empty links to the product page."
msgstr "Wohin der Button führt. Leer verlinkt auf die Produktseite."

#: includes/class-px-catalog.php:152
#: templates/emails/px-waitlist-in-stock.php:27
#: templates/emails/px-waitlist-subscribed.php:25
