msgid ""
msgstr ""
"Project-Id-Version: PX Shop Core 0.1.0\n"
"Language: sk_SK\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"
"X-Domain: px-shop-core\n"

#. translators: %s: brand name.
msgid "About %s"
msgstr "O značke %s"

msgid "About the brand"
msgstr "O značke"

#. translators: %s: brand name.
msgid "All products by %s"
msgstr "Všetky produkty %s"

#. translators: %s: formatted price.
msgid "Lowest price in the last 30 days: %s"
msgstr "Najnižšia cena za posledných 30 dní: %s"

msgid "Product safety (GPSR)"
msgstr "Bezpečnosť produktu (GPSR)"

msgid "Safety & compliance"
msgstr "Bezpečnosť a súlad"

msgid "Manufacturer"
msgstr "Výrobca"

msgid "EU responsible person"
msgstr "Zodpovedná osoba v EÚ"

msgid "Country of origin"
msgstr "Krajina pôvodu"

msgid "Safety warnings"
msgstr "Bezpečnostné upozornenia"

msgid "Safety documentation"
msgstr "Bezpečnostná dokumentácia"

msgid "Filled in once here and shown on every product of this brand. A product overrides it only by filling the same field in its own Product safety (GPSR) tab."
msgstr "Vyplní sa raz tu a zobrazí sa pri každom produkte tejto značky. Produkt to prebije, len ak rovnaké pole vyplní vo svojej karte Bezpečnosť produktu (GPSR)."

msgid "Taken from brand %s."
msgstr "Preberá sa zo značky %s."

msgid "Edit source"
msgstr "Upraviť zdroj"

msgid "Filled in on the product brand (Products → Brands) - it is then used by every product of that brand."
msgstr "Vypĺňa sa na značke produktu (Produkty → Značky) — použije sa potom pri každom produkte tej značky."

msgid "Content"
msgstr "Obsah"

msgid "Content item"
msgstr "Položka obsahu"

msgid "Add content item"
msgstr "Pridať položku obsahu"

msgid "Edit content item"
msgstr "Upraviť položku obsahu"

msgid "Search content"
msgstr "Hľadať v obsahu"

msgid "No content items found."
msgstr "Nenašli sa žiadne položky obsahu."

msgid "Reusable content blocks (banners etc.) rendered by the theme."
msgstr "Znovupoužiteľné bloky obsahu (bannery a pod.) vykresľované témou."

msgid "Content categories"
msgstr "Kategórie obsahu"

msgid "Content category"
msgstr "Kategória obsahu"

msgid "Add content category"
msgstr "Pridať kategóriu obsahu"

msgid "Edit content category"
msgstr "Upraviť kategóriu obsahu"

msgid "Search content categories"
msgstr "Hľadať kategórie obsahu"

msgid "Invalid product."
msgstr "Neplatný produkt."

msgid "Your wishlist is empty."
msgstr "Váš zoznam želaní je prázdny."

msgid "Browse products"
msgstr "Prezrieť produkty"

msgid "No products to compare yet."
msgstr "Zatiaľ žiadne produkty na porovnanie."

msgid "Remove"
msgstr "Odstrániť"

msgid "Product"
msgstr "Produkt"

msgid "Price"
msgstr "Cena"

msgid "Availability"
msgstr "Dostupnosť"

msgid "In stock"
msgstr "Skladom"

msgid "Out of stock"
msgstr "Vypredané"

msgid "Please enter a valid e-mail address."
msgstr "Zadajte platnú e-mailovú adresu."

msgid "The waitlist for this product is full."
msgstr "Zoznam čakateľov pre tento produkt je plný."

msgid "This product is already in stock."
msgstr "Tento produkt je už skladom."

msgid "Thank you! We will e-mail you as soon as the product is back in stock."
msgstr "Ďakujeme! Hneď ako bude produkt opäť skladom, pošleme vám e-mail."

msgid "%s is back in stock"
msgstr "%s je opäť skladom"

msgid "Good news - %s is available again."
msgstr "Dobrá správa – %s je opäť dostupný."

msgid "View product"
msgstr "Zobraziť produkt"

msgid "Waitlist"
msgstr "Zoznam čakateľov"

msgid "Customers waiting for this product: %d"
msgstr "Zákazníci čakajúci na tento produkt: %d"

msgid "Banner display"
msgstr "Zobrazenie bannera"

msgid "Title = heading, Excerpt = intro text above the buttons, editor = free text, Featured image = banner image. Empty fields are simply not rendered."
msgstr "Titulok = nadpis, Zhrnutie = perex nad tlačidlami, editor = voľný text, Náhľadový obrázok = obrázok bannera. Nevyplnené polia sa jednoducho nevykreslia."

msgid "Layout"
msgstr "Rozloženie"

msgid "Text left, image right"
msgstr "Text vľavo, obrázok vpravo"

msgid "Image left, text right"
msgstr "Obrázok vľavo, text vpravo"

msgid "Image background, text over it"
msgstr "Obrázok na pozadí, text v prekryve"

msgid "Text and buttons only"
msgstr "Len text a tlačidlá"

msgid "Eyebrow"
msgstr "Nadtitulok"

msgid "Small line above the heading."
msgstr "Krátky riadok nad nadpisom."

msgid "Text alignment"
msgstr "Zarovnanie textu"

msgid "Left"
msgstr "Vľavo"

msgid "Center"
msgstr "Na stred"

msgid "Right"
msgstr "Vpravo"

msgid "Image dimming (%)"
msgstr "Stmavenie obrázka (%)"

msgid "Dark layer between image and text, so the text stays readable."
msgstr "Tmavá vrstva medzi obrázkom a textom, aby text ostal čitateľný."

msgid "Button text"
msgstr "Text tlačidla"

msgid "Button link"
msgstr "Odkaz tlačidla"

msgid "Second button text"
msgstr "Text druhého tlačidla"

msgid "Second button link"
msgstr "Odkaz druhého tlačidla"

#. translators: %s: shortcode example
msgid "A button shows only when both its fields are filled. Place the banner anywhere with %s."
msgstr "Tlačidlo sa zobrazí, len keď sú vyplnené obe jeho polia. Banner sa dá vložiť kamkoľvek cez %s."

msgid "Catalog mode"
msgstr "Katalógový režim"

msgid "Turn the shop into a browse-only catalog: add-to-cart buttons and the cart are hidden. Useful for showrooms or price-on-request shops."
msgstr "Zmení e-shop na katalóg len na prezeranie: tlačidlá do košíka a samotný košík sú skryté. Vhodné pre showroomy alebo obchody s cenou na vyžiadanie."

msgid "Enable catalog mode"
msgstr "Zapnúť katalógový režim"

msgid "Prices"
msgstr "Ceny"

msgid "Also hide prices"
msgstr "Skryť aj ceny"

msgid "Replacement button text"
msgstr "Text náhradného tlačidla"

msgid "Shown instead of \"Add to cart\". Empty falls back to \"View product\"."
msgstr "Zobrazí sa namiesto „Pridať do košíka“. Prázdne použije „Zobraziť produkt“."

msgid "Replacement button link"
msgstr "Odkaz náhradného tlačidla"

msgid "Where the button points. Empty links to the product page."
msgstr "Kam tlačidlo smeruje. Prázdne odkazuje na stránku produktu."

msgid "Image"
msgstr "Obrázok"

msgid "Select image"
msgstr "Vybrať obrázok"

msgid "Use image"
msgstr "Použiť obrázok"

msgid "Remove image"
msgstr "Odstrániť obrázok"

msgid "Optional image for this attribute value (swatch, logo, ...)."
msgstr "Voliteľný obrázok pre túto hodnotu vlastnosti (vzorka, logo, ...)."

msgid "Size guides"
msgstr "Veľkostné tabuľky"

msgid "Size guide"
msgstr "Veľkostná tabuľka"

msgid "Add size guide"
msgstr "Pridať veľkostnú tabuľku"

msgid "Edit size guide"
msgstr "Upraviť veľkostnú tabuľku"

msgid "Search size guides"
msgstr "Hľadať veľkostné tabuľky"

msgid "No size guides yet."
msgstr "Zatiaľ tu nie je žiadna veľkostná tabuľka."

msgid "No size guides in the trash."
msgstr "V koši nie je žiadna veľkostná tabuľka."

msgid "Size table"
msgstr "Tabuľka veľkostí"

msgid "One row per line, cells separated by | (a table pasted from a spreadsheet works too). The first row is the header."
msgstr "Jeden riadok tabuľky na riadok, bunky oddelené znakom | (funguje aj tabuľka vložená z tabuľkového procesora). Prvý riadok je hlavička."

msgid "Hide the table and show only the content above"
msgstr "Skryť tabuľku a zobraziť len obsah nad ňou"

msgid "Assigned categories:"
msgstr "Priradené kategórie:"

msgid "Not assigned to any category yet - a guide is picked on the product, or on the product category screen."
msgstr "Zatiaľ bez kategórie — tabuľka sa priraďuje pri produkte alebo na stránke kategórie produktov."

msgid "— inherit from category —"
msgstr "— podľa kategórie —"

msgid "— do not show —"
msgstr "— nezobrazovať —"

msgid "— none —"
msgstr "— žiadna —"

msgid "Used by products in this category that do not pick a guide themselves."
msgstr "Použije sa pri produktoch tejto kategórie, ktoré nemajú vlastnú tabuľku."

msgid "do not show"
msgstr "nezobrazovať"

#. translators: %s: name of the size guide inherited from the old theme.
msgid "Still using the guide from the old theme: %s"
msgstr "Zatiaľ platí tabuľka zo starej témy: %s"

msgid "Close"
msgstr "Zavrieť"

msgid "This link is no longer valid."
msgstr "Tento odkaz už neplatí."

msgid "Done - we will e-mail you as soon as the product is back in stock."
msgstr "Hotovo — ozveme sa hneď, ako bude produkt opäť skladom."

msgid "Done - we will not e-mail you about product availability again."
msgstr "Hotovo — o dostupnosti produktov ti už písať nebudeme."

msgid "Almost there - open the e-mail we just sent and confirm your address."
msgstr "Ešte krok — otvor e-mail, ktorý sme práve poslali, a potvrď adresu."

msgid "(not confirmed)"
msgstr "(nepotvrdené)"

msgid "Waitlist: confirm the address"
msgstr "Sledovanie dostupnosti: potvrdenie adresy"

msgid "Sent right after someone asks to be told when a product is back in stock. Until they click the link in it, they are not on the list."
msgstr "Odchádza hneď po prihlásení na sledovanie dostupnosti. Kým zákazník neklikne na odkaz v ňom, na zozname nie je."

msgid "Confirm you want to hear about {product_name}"
msgstr "Potvrď sledovanie dostupnosti — {product_name}"

msgid "One click and you are on the list"
msgstr "Jedno kliknutie a si na zozname"

msgid "Waitlist: subscription confirmed"
msgstr "Sledovanie dostupnosti: potvrdené prihlásenie"

msgid "Sent after the customer confirms the address. Carries the unsubscribe link."
msgstr "Odchádza po potvrdení adresy. Nesie odkaz na odhlásenie."

msgid "We will let you know about {product_name}"
msgstr "Dáme vedieť, keď bude {product_name} skladom"

msgid "You are on the list"
msgstr "Si na zozname"

msgid "Waitlist: product is back in stock"
msgstr "Sledovanie dostupnosti: produkt je skladom"

msgid "Sent to confirmed subscribers when the product they are waiting for is available again."
msgstr "Odchádza potvrdeným záujemcom, keď je sledovaný produkt opäť dostupný."

msgid "{product_name} is back in stock"
msgstr "{product_name} je opäť skladom"

msgid "Back in stock"
msgstr "Opäť skladom"

msgid "Waitlist: new subscriber (admin)"
msgstr "Sledovanie dostupnosti: nový záujemca (admin)"

msgid "Tells the shop that somebody is waiting for a product that is out of stock."
msgstr "Oznámi obchodu, že niekto čaká na produkt, ktorý nie je skladom."

msgid "Waitlist: somebody is waiting for {product_name}"
msgstr "Sledovanie dostupnosti: niekto čaká na {product_name}"

msgid "New waitlist subscriber"
msgstr "Nový záujemca o naskladnenie"

msgid "Recipient(s)"
msgstr "Príjemca(ovia)"

msgid "Comma separated. Defaults to %s."
msgstr "Oddelené čiarkou. Predvolene %s."

msgid "Somebody (we hope you) asked us to send an e-mail as soon as %s is available again."
msgstr "Niekto (dúfame, že ty) nás požiadal, aby sme dali vedieť, keď bude %s opäť dostupný."

msgid "Confirm the address and we will do exactly that - nothing else, no newsletter."
msgstr "Potvrď adresu a presne to urobíme — nič iné, žiadny newsletter."

msgid "Yes, let me know"
msgstr "Áno, dajte mi vedieť"

msgid "If the button does not work, open this address:"
msgstr "Ak tlačidlo nefunguje, otvor túto adresu:"

msgid "If it was not you, just ignore this message - without the click above nothing happens."
msgstr "Ak si to nebol ty, správu pokojne ignoruj — bez kliknutia vyššie sa nič nestane."

msgid "If it was not you, just ignore this message - without the link above nothing happens."
msgstr "Ak si to nebol ty, správu pokojne ignoruj — bez odkazu vyššie sa nič nestane."

msgid "Thank you - we will e-mail you as soon as %s is back in stock."
msgstr "Ďakujeme — ozveme sa hneď, ako bude %s opäť skladom."

msgid "Stop e-mailing me about availability"
msgstr "Nechcem už e-maily o dostupnosti"

msgid "Stop e-mailing me about availability:"
msgstr "Nechcem už e-maily o dostupnosti:"

msgid "Stock is limited - this message went to everybody who was waiting."
msgstr "Zásoba je obmedzená — správa odišla všetkým, ktorí čakali."

msgid "%1$s is waiting for %2$s."
msgstr "%1$s čaká na %2$s."

msgid "SKU:"
msgstr "SKU:"

msgid "Waiting in total:"
msgstr "Čakajúcich spolu:"

msgid "Edit product"
msgstr "Upraviť produkt"

msgid "Out of stock. Leave your e-mail and we will tell you when it is back."
msgstr "Nie je skladom. Nechaj e-mail a dáme vedieť, keď bude späť."

msgid "Your e-mail"
msgstr "Tvoj e-mail"

msgid "your@email.com"
msgstr "tvoj@email.sk"

msgid "Notify me"
msgstr "Dajte mi vedieť"

msgid "Something went wrong, please try again."
msgstr "Niečo sa pokazilo, skús to prosím znova."

msgid "Sale validity"
msgstr "Platnosť akcie"

msgid "Shows until when a discounted price applies, as a date or a countdown near the end."
msgstr "Ukáže, dokedy platí akciová cena — dátumom, tesne pred koncom odpočtom."

msgid "Shows how long a discounted price applies. The date comes from the product (Sale price dates); products discounted by a plugin that sets no dates fall back to the shop-wide campaign end below."
msgstr "Ukáže, ako dlho platí akciová cena. Dátum berie z produktu (Platnosť akciovej ceny); produkty zľavnené pluginom, ktorý dátumy nenastavuje, použijú koniec kampane pre celý obchod nižšie."

msgid "Product cards"
msgstr "Produktové karty"

msgid "Show the end of the sale on product cards"
msgstr "Zobraziť koniec akcie na produktových kartách"

msgid "Product detail"
msgstr "Detail produktu"

msgid "Show the end of the sale on the product page"
msgstr "Zobraziť koniec akcie na stránke produktu"

msgid "Live countdown under"
msgstr "Živý odpočet menej než"

msgid "hours before the end. The date turns into a ticking countdown; 0 keeps the date."
msgstr "hodín do konca. Dátum sa zmení na bežiaci odpočet; 0 nechá dátum."

msgid "Hide when further away than"
msgstr "Skryť, ak je koniec ďalej než"

msgid "days. A sale running for months is not news; 0 always shows the date."
msgstr "dní. Akcia bežiaca mesiace nie je novina; 0 zobrazí dátum vždy."

msgid "Shop-wide campaign end"
msgstr "Koniec kampane pre celý obchod"

msgid "Used for products whose discount carries no date of its own - typically a sitewide discount plugin. Leave empty when every sale has its own dates."
msgstr "Použije sa pri produktoch, ktorých zľava nemá vlastný dátum — typicky plugin s plošnou zľavou. Nechaj prázdne, keď má každá akcia vlastné dátumy."

#. translators: %s: date the sale price stops applying.
msgid "Sale price valid until %s"
msgstr "Akciová cena platí do %s"

msgid "Related categories"
msgstr "Súvisiace kategórie"

msgid "Accessories set once per product category instead of product by product (\"bicycles\" go with \"lights\" and \"bottle cages\"). Subcategories inherit from their parent."
msgstr "Doplnky sa nastavia raz na kategórii, nie na každom produkte („bicykle“ idú so „svetlami“ a „košíkmi na fľaše“). Podkategórie dedia od rodiča."

msgid "Which categories go with which is set on the category itself (Products → Categories). Subcategories inherit from their parent, so one setting usually covers a whole branch."
msgstr "Čo s čím súvisí sa nastavuje priamo na kategórii (Produkty → Kategórie). Podkategórie dedia od rodiča, takže jedno nastavenie zvyčajne pokryje celú vetvu."

msgid "Number of products"
msgstr "Počet produktov"

msgid "How many products the theme gets. They are taken in turn from each related category, so one category cannot fill the whole row."
msgstr "Koľko produktov dostane téma. Berú sa striedavo z každej súvisiacej kategórie, takže jedna kategória nezaplní celý riadok."

msgid "Which products first"
msgstr "Ktoré produkty najskôr"

msgid "Order inside each related category."
msgstr "Poradie v rámci každej súvisiacej kategórie."

msgid "Best selling"
msgstr "Najpredávanejšie"

msgid "Newest"
msgstr "Najnovšie"

msgid "Category order (menu order)"
msgstr "Poradie v kategórii (menu order)"

msgid "Heading"
msgstr "Nadpis"

msgid "Used when the category does not set its own. Empty falls back to \"Goes well with this\"."
msgstr "Použije sa, keď kategória nemá vlastný. Prázdne znamená „Hodí sa k tomuto“."

msgid "Cart"
msgstr "Košík"

msgid "Offer them in the cart as well"
msgstr "Ponúkať ich aj v košíku"

msgid "Adds them to the cart cross-sells, after the ones the products name themselves. Applies to the classic cart; the block cart draws its own."
msgstr "Pridá ich ku krížovému predaju v košíku, za tie, ktoré majú produkty nastavené samy. Platí pre klasický košík; blokový si kreslí vlastné."

msgid "Cache"
msgstr "Cache"

msgid "Hours before the product list is looked up again. 0 turns caching off (development only)."
msgstr "Po koľkých hodinách sa zoznam produktov vyhľadá nanovo. 0 vypne cache (len pri vývoji)."

msgid "Goes well with this"
msgstr "Hodí sa k tomuto"

msgid "Optional. Shown above the products instead of the default one."
msgstr "Voliteľné. Zobrazí sa nad produktmi namiesto predvoleného."

msgid "Products in this category will offer products from the categories ticked here. Subcategories inherit this, so ticking it on the top category is usually enough."
msgstr "Produkty v tejto kategórii budú ponúkať produkty z tu zaškrtnutých kategórií. Podkategórie to dedia, takže zvyčajne stačí zaškrtnúť na najvyššej kategórii."

#. translators: %s: name of the parent category the setting is inherited from.
msgid "Nothing ticked: the list is inherited from %s."
msgstr "Nič nie je zaškrtnuté: zoznam sa dedí z %s."

msgid "No product categories yet."
msgstr "Zatiaľ nie sú žiadne kategórie produktov."

msgid "Related"
msgstr "Súvisiace"

msgid "inherited"
msgstr "zdedené"

msgid "Search categories…"
msgstr "Hľadať kategórie…"

msgid "Selected only"
msgstr "Len vybrané"

msgid "PX Shop"
msgstr "PX Shop"

msgid "Modules"
msgstr "Moduly"

msgid "Only the modules switched on here are loaded. A module that is off registers no hooks, no REST routes and no admin screens; stored data (waitlist subscribers, wishlists, GPSR fields) stays untouched and comes back with it."
msgstr "Načítajú sa len moduly zapnuté tu. Vypnutý modul neregistruje žiadne hooky, REST cesty ani obrazovky v administrácii; uložené dáta (prihlásení na dostupnosť, obľúbené produkty, GPSR polia) ostávajú nedotknuté a vrátia sa spolu s ním."

msgid "Overridden in code - the switch below has no effect."
msgstr "Prepísané v kóde — prepínač nižšie nemá účinok."

msgid "Content blocks"
msgstr "Obsahové bloky"

msgid "Non-public \"Content\" post type for reusable blocks (banners, USP strips) rendered by the theme."
msgstr "Neverejný typ obsahu „Obsah“ pre opakovane použiteľné bloky (bannery, pásy výhod), ktoré vykresľuje téma."

msgid "Live search"
msgstr "Živé vyhľadávanie"

msgid "REST endpoint behind the search field in the header."
msgstr "REST endpoint za vyhľadávacím poľom v hlavičke."

msgid "Brand tab"
msgstr "Karta značky"

msgid "Adds an \"About the brand\" product tab from the product_brand term description."
msgstr "Pridá k produktu kartu „O značke“ z popisu značky (term product_brand)."

msgid "EU Omnibus"
msgstr "EU Omnibus"

msgid "Records price history and shows the lowest price of the last 30 days on discounted products."
msgstr "Zaznamenáva históriu cien a pri zľavnených produktoch ukazuje najnižšiu cenu za posledných 30 dní."

msgid "GPSR product safety"
msgstr "Bezpečnosť produktov (GPSR)"

msgid "Manufacturer, safety warnings and instructions on products, with the data tab in admin."
msgstr "Výrobca, bezpečnostné upozornenia a návody pri produktoch, aj s kartou údajov v administrácii."

msgid "Wishlist"
msgstr "Obľúbené produkty"

msgid "Favourite products per customer (user meta, cookie for guests) with REST endpoints."
msgstr "Obľúbené produkty pre každého zákazníka (user meta, pri neprihlásených cookie) s REST endpointmi."

msgid "Compare"
msgstr "Porovnanie produktov"

msgid "Side-by-side comparison of up to four products (cookie based) with REST endpoints."
msgstr "Porovnanie až štyroch produktov vedľa seba (na základe cookie) s REST endpointmi."

msgid "Free shipping bar"
msgstr "Pás dopravy zadarmo"

msgid "Data for the \"how much is left to free shipping\" progress bar drawn by the theme."
msgstr "Údaje pre ukazovateľ „koľko chýba do dopravy zadarmo“, ktorý kreslí téma."

msgid "Back-in-stock waitlist"
msgstr "Stráženie dostupnosti"

msgid "Visitors subscribe to an out-of-stock product (double opt-in) and are mailed once it is back."
msgstr "Návštevník sa prihlási pri vypredanom produkte (double opt-in) a dostane e-mail, keď bude opäť skladom."

msgid "Size tables assigned to a product or inherited from its category."
msgstr "Tabuľky veľkostí priradené produktu alebo zdedené z jeho kategórie."

msgid "Attribute images"
msgstr "Obrázky atribútov"

msgid "Image field on every product attribute term (pa_*), used by swatches and filters."
msgstr "Pole s obrázkom pri každom terme atribútu produktu (pa_*), používajú ho vzorkovníky a filtre."

msgid "Makes a browse-only shop possible. The mode itself is switched on in this module's settings."
msgstr "Umožní obchod len na prezeranie. Samotný režim sa zapína v nastaveniach tohto modulu."

msgid "Page holding the [px_wishlist] shortcode. Themes link to it from the header icon; with no page set the link is simply not rendered."
msgstr "Stránka so shortcode [px_wishlist]. Téma na ňu odkazuje z ikony v hlavičke; bez nastavenej stránky sa odkaz jednoducho nevykreslí."

msgid "Wishlist page"
msgstr "Stránka Obľúbené"

msgid "Page where the comparison table is rendered. Themes link to it from the compare counter; with no page set the link is simply not rendered."
msgstr "Stránka, na ktorej sa vykreslí porovnávacia tabuľka. Téma na ňu odkazuje z počítadla porovnania; bez nastavenej stránky sa odkaz jednoducho nevykreslí."

msgid "Compare page"
msgstr "Stránka Porovnanie"

msgid "PX Shop Core: the \"Company details\" module is switched on, but WPify Woo still handles IČO and DIČ. Turn off its \"IČ DIČ\" module (or deactivate the plugin) and the fields will be served by PX Shop Core - the stored data is the same and stays where it is."
msgstr "PX Shop Core: modul „Firemné údaje“ je zapnutý, ale IČO a DIČ stále obsluhuje WPify Woo. Vypnite jeho modul „IČ DIČ“ (alebo plugin deaktivujte) a polia prevezme PX Shop Core — uložené údaje sú tie isté a zostávajú, kde sú."

msgid "Checkout fields"
msgstr "Polia v pokladni"

msgid "IČO, DIČ and IČ DPH are stored as _billing_ic, _billing_dic and _billing_dic_dph, the keys invoicing plugins and exports already expect. IČ DPH is only shown for Slovak billing addresses; elsewhere the VAT id belongs in DIČ."
msgstr "IČO, DIČ a IČ DPH sa ukladajú do kľúčov _billing_ic, _billing_dic a _billing_dic_dph, teda tam, kde ich fakturačné pluginy a exporty už hľadajú. IČ DPH sa zobrazuje len pri slovenskej fakturačnej adrese; inde patrí IČ DPH do poľa DIČ."

msgid "Company checkbox"
msgstr "Políčko „nakupujem na firmu“"

msgid "Show the \"I'm buying for a company\" checkbox and keep the fields hidden until it is ticked"
msgstr "Zobraziť políčko „Nakupujem na firmu“ a firemné polia ukázať až po jeho zaškrtnutí"

msgid "Field position"
msgstr "Umiestnenie polí"

msgid "Move the company block above the name and address"
msgstr "Presunúť firemný blok nad meno a adresu"

msgid "Company customers then fill the register lookup first and get the rest of the form filled for them."
msgstr "Firemný zákazník potom začne načítaním z registra a zvyšok formulára sa mu vyplní sám."

msgid "Company name"
msgstr "Názov firmy"

msgid "Required when buying for a company"
msgstr "Povinný pri nákupe na firmu"

msgid "Identification number"
msgstr "IČO"

msgid "When is IČO required?"
msgstr "Kedy je IČO povinné?"

msgid "When the company checkbox is ticked"
msgstr "Keď je zaškrtnuté políčko „nakupujem na firmu“"

msgid "When the company name is filled in"
msgstr "Keď je vyplnený názov firmy"

msgid "Never"
msgstr "Nikdy"

msgid "Format check"
msgstr "Kontrola formátu"

msgid "Reject numbers that cannot be right before the order is placed"
msgstr "Odmietnuť čísla, ktoré nemôžu byť správne, ešte pred odoslaním objednávky"

msgid "IČO 8 digits, SK DIČ 10 digits, SK IČ DPH SK + 10 digits, other EU VAT ids country prefix + number."
msgstr "IČO 8 číslic, SK DIČ 10 číslic, SK IČ DPH SK + 10 číslic, ostatné EÚ predpona krajiny + číslo."

msgid "Public registers"
msgstr "Verejné registre"

msgid "RPO (Statistical Office) for Slovak numbers, ARES (Ministry of Finance) for Czech ones. Both are free, need no key and are queried straight from the shop; answers are cached for a week."
msgstr "RPO (Štatistický úrad SR) pre slovenské čísla, ARES (MF ČR) pre české. Oboje je zadarmo, bez kľúča a volá sa priamo z obchodu; odpovede sa kešujú na týždeň."

msgid "Fill in from the register"
msgstr "Doplniť z registra"

msgid "Offer a \"Load from register\" button next to IČO"
msgstr "Ponúknuť pri IČO tlačidlo „Načítať z registra“"

msgid "Fills the company name and registered address. The customer can still edit everything afterwards."
msgstr "Doplní názov firmy a sídlo. Zákazník môže všetko potom upraviť."

msgid "Verify the number"
msgstr "Overiť číslo"

msgid "Refuse an IČO the register does not know"
msgstr "Odmietnuť IČO, ktoré register nepozná"

msgid "Checked when the order is placed. If the register is down the order goes through - the outage is ours to log, not the customer's to solve."
msgstr "Kontroluje sa pri odoslaní objednávky. Keď register nefunguje, objednávka prejde — výpadok je náš na zalogovanie, nie zákazníkov na riešenie."

msgid "VAT id verification (VIES)"
msgstr "Overenie IČ DPH (VIES)"

msgid "VIES is the European Commission register of VAT identification numbers. It is the only evidence that a reverse-charge invoice was issued to a real VAT payer, so keep it on wherever the reverse charge is on."
msgstr "VIES je register identifikačných čísel pre DPH Európskej komisie. Je jediným dokladom, že faktúra s prenesením daňovej povinnosti šla skutočnému platiteľovi DPH — nechajte ho preto zapnutý všade, kde je zapnuté prenesenie."

msgid "VIES check"
msgstr "Kontrola vo VIES"

msgid "Off"
msgstr "Vypnutá"

msgid "Check and warn, let the order through"
msgstr "Overiť a upozorniť, objednávku pustiť"

msgid "Check and refuse an unverified VAT id"
msgstr "Overiť a neoverené IČ DPH odmietnuť"

msgid "A VIES outage never blocks an order, not even in the strict setting - only an answer saying the number is unknown does."
msgstr "Výpadok VIES objednávku nezastaví nikdy, ani pri prísnom nastavení — zastaví ju len odpoveď, že číslo neexistuje."

msgid "VAT exemption"
msgstr "Oslobodenie od DPH"

msgid "Which country decides follows the WooCommerce setting <em>Calculate tax based on</em> (%s): the shipping country for goods, the billing country for services. Leave both switches off in a shop that sells at home only."
msgstr "Ktorá krajina rozhoduje, sa riadi nastavením WooCommerce <em>Vypočítať daň podľa</em> (%s): pri tovare dodacia krajina, pri službách fakturačná. V obchode, ktorý predáva len doma, nechajte oba prepínače vypnuté."

msgid "WooCommerce → Settings → Tax"
msgstr "WooCommerce → Nastavenia → Daň"

msgid "EU reverse charge"
msgstr "Prenesenie daňovej povinnosti (EÚ)"

msgid "No VAT for a business customer in another EU country"
msgstr "Bez DPH pre firemného zákazníka v inej krajine EÚ"

msgid "The invoice has to carry the \"reverse charge\" notice and the order belongs in the EC Sales List."
msgstr "Faktúra musí niesť poznámku „prenesenie daňovej povinnosti“ a objednávka patrí do súhrnného výkazu."

msgid "Export outside the EU"
msgstr "Vývoz mimo EÚ"

msgid "No VAT when the goods leave the EU"
msgstr "Bez DPH, keď tovar opúšťa EÚ"

msgid "Applies to consumers as well as businesses. You need the customs proof of export to defend it."
msgstr "Platí pre občanov aj firmy. Na obhájenie potrebujete colný doklad o vývoze."

msgid "Proof required"
msgstr "Vyžadovať doklad"

msgid "Only drop the VAT when VIES confirms the VAT id"
msgstr "DPH odpustiť len vtedy, keď VIES potvrdí IČ DPH"

msgid "With this off, any correctly formatted VAT id is enough and the tax risk is the shop's. Turning it on with the VIES check off leaves the reverse charge inactive."
msgstr "Pri vypnutom stačí správne naformátované IČ DPH a daňové riziko nesie obchod. So zapnutým a s vypnutou kontrolou vo VIES prenesenie daňovej povinnosti nenastane nikdy."

msgid "Company ID"
msgstr "IČO"

msgid "12345678"
msgstr "12345678"

msgid "Tax ID"
msgstr "DIČ"

msgid "VAT ID"
msgstr "IČ DPH"

msgid "SK1234567890"
msgstr "SK1234567890"

msgid "I'm buying for a company"
msgstr "Nakupujem na firmu"

msgid "Load from register"
msgstr "Načítať z registra"

msgid "Loading…"
msgstr "Načítavam…"

msgid "Details filled in from the register."
msgstr "Údaje doplnené z registra."

msgid "VAT id verified in VIES."
msgstr "IČ DPH overené vo VIES."

msgid "VIES does not know this VAT id."
msgstr "VIES toto IČ DPH nepozná."

msgid "VIES did not answer, the number could not be verified."
msgstr "VIES neodpovedal, číslo sa nepodarilo overiť."

msgid "The register did not answer. Please fill the details in by hand."
msgstr "Register neodpovedal. Vyplňte údaje, prosím, ručne."

msgid "The VAT id was not found in VIES. Please check it, or leave it empty and the order will be invoiced with VAT."
msgstr "IČ DPH sa vo VIES nenašlo. Skontrolujte ho, prosím, alebo pole nechajte prázdne a objednávka sa vyfakturuje s DPH."

msgid "%s is a required field when buying for a company."
msgstr "%s je pri nákupe na firmu povinné pole."

msgid "The company ID is not in the expected format (8 digits, no spaces)."
msgstr "IČO nie je v očakávanom formáte (8 číslic, bez medzier)."

msgid "The company ID is not in the expected format."
msgstr "IČO nie je v očakávanom formáte."

msgid "The tax ID is not in the expected format (10 digits, no spaces)."
msgstr "DIČ nie je v očakávanom formáte (10 číslic, bez medzier)."

msgid "The VAT ID is not in the expected format (SK followed by 10 digits)."
msgstr "IČ DPH nie je v očakávanom formáte (SK a 10 číslic)."

msgid "The VAT ID has to be the tax ID with an SK prefix."
msgstr "IČ DPH musí byť DIČ s predponou SK."

msgid "The tax ID is not in the expected format (prefix %s followed by the number)."
msgstr "DIČ nie je v očakávanom formáte (predpona %s a číslo)."

msgid "Domestic sale, VAT charged."
msgstr "Tuzemský predaj, DPH účtovaná."

msgid "VAT charged."
msgstr "DPH účtovaná."

msgid "Export outside the EU, VAT not charged."
msgstr "Vývoz mimo EÚ, DPH neúčtovaná."

msgid "EU reverse charge, VAT not charged (VAT id verified)."
msgstr "Prenesenie daňovej povinnosti v EÚ, DPH neúčtovaná (IČ DPH overené)."

msgid "VAT id could not be verified, VAT charged."
msgstr "IČ DPH sa nepodarilo overiť, DPH účtovaná."

msgid "VAT"
msgstr "DPH"

msgid "Register lookup is switched off."
msgstr "Načítanie z registra je vypnuté."

msgid "Too many requests, please wait a moment."
msgstr "Priveľa požiadaviek, chvíľu, prosím, počkajte."

msgid "VAT id verification is switched off."
msgstr "Overovanie IČ DPH je vypnuté."

msgid "Enter an identification number first."
msgstr "Najprv zadajte IČO."

msgid "There is no register available for this country."
msgstr "Pre túto krajinu nie je dostupný register."

msgid "This company is no longer registered in RPO."
msgstr "Táto firma už nie je v RPO zapísaná."

msgid "This company is no longer registered in ARES."
msgstr "Táto firma už nie je v ARES zapísaná."

msgid "Not found in the register."
msgstr "V registri sa nenašlo."

msgid "This identification number is not in the ARES register."
msgstr "Toto IČO nie je v registri ARES."

msgid "This identification number is not in the RPO register."
msgstr "Toto IČO nie je v registri RPO."

msgid "Company details"
msgstr "Firemné údaje"

msgid "IČO, DIČ and IČ DPH on the checkout, filled in from the RPO/ARES register, VAT id verified in VIES, EU reverse charge and export outside the EU. Off by default - switch it on only once the plugin that used to handle these fields is gone, or the checkout shows them twice."
msgstr "IČO, DIČ a IČ DPH v pokladni, doplnenie z registra RPO/ARES, overenie IČ DPH vo VIES, prenesenie daňovej povinnosti v EÚ a vývoz mimo EÚ. Predvolene vypnuté — zapnite až potom, čo je preč plugin, ktorý tieto polia obsluhoval doteraz, inak budú v pokladni dvakrát."

