<?xml version="1.0"?>
<!--
  Kontrola štýlu a bezpečnosti — WordPress Coding Standards.
  Spúšťa sa z ~/localhost/px-shop-dev: bin/lint.sh px-shop-core (nástroje sú tam,
  v repe je len konfigurácia). Do balíka releasu nejde.
-->
<ruleset name="px-shop-core">
	<description>px-shop-core: WordPress-Extra + PHPCompatibility</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs">
		<severity>0</severity>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="px-shop-core"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="px"/>
				<element value="PX"/>
			</property>
		</properties>
	</rule>

	<!-- Súbory sa volajú podľa obsahu (class-px-*.php, template-parts), nie podľa WP konvencie. -->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

</ruleset>
